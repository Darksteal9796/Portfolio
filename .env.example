# Copy to .env.local and fill in. Never commit real values.

# Resend — contact form email delivery (https://resend.com)
RESEND_API_KEY=

# GitHub — read-only PAT for the GithubTile (public_repo scope)
GITHUB_TOKEN=

# Public site URL — used for canonical URLs, OG tags, sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
